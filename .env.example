# Copia este archivo a `.env` y completa los valores.
# El archivo .env está ignorado por git y nunca debe subirse.

# Token del bot de Telegram (obtenerlo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=123456:ABCDEF-reemplaza-esto

# API key de Groq (https://console.groq.com → API Keys)
GROQ_API_KEY=gsk_reemplaza-esto

# Modelo de Groq a utilizar
GROQ_MODEL=llama-3.3-70b-versatile

# development | production
ENVIRONMENT=development
